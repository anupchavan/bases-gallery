{
	"name": "media-manager",
	"version": "0.0.3",
	"description": "Manage media files as Markdown notes.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint . --max-warnings 0 && stylelint styles.css --max-warnings 0",
		"lint:fix": "eslint . --fix",
		"test": "node --test 'scripts/*.test.mjs' 'test/*.test.mjs'",
		"sync:local": "node scripts/sync-local.mjs"
	},
	"keywords": [],
	"license": "0-BSD",
	"devDependencies": {
		"@codemirror/state": "6.7.6",
		"@codemirror/view": "6.43.13",
		"@eslint/js": "^10.0.1",
		"@types/node": "^26.6.6",
		"esbuild": "0.28.2",
		"eslint": "^10.14.0",
		"eslint-plugin-obsidianmd": "^0.5.0",
		"globals": "^17.14.0",
		"jiti": "^2.7.0",
		"obsidian": "^1.14.4",
		"stylelint": "^18.0.0",
		"stylelint-no-unsupported-browser-features": "^8.1.2",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.1"
	}
}
